{
  "name": "dsh-acp-enhanced",
  "version": "0.9.0",
  "description": "Enhanced ACP server for DeepSeek Harness: block-level streaming, usage/stat telemetry (cache hit rate, token speed, input/output tokens, context length, turns, tool timing), model & reasoning-effort switching, and permission-preset control over the ACP wire (Zed-friendly)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "acp",
    "agent-client-protocol",
    "zed",
    "zed-editor",
    "ai-agent",
    "coding-assistant",
    "llm"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "profile",
    "scripts/dsh-acp-zed.sh",
    "scripts/init-acp-home.sh",
    "scripts/acp-doctor.mjs",
    "scripts/lib/dsh-version.mjs",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "node scripts/acp-doctor.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-session-query": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2 || ^0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-instructions": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-permission-presets": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2"
  },
